      "id": "guarded-mode-controller",
      "name": "Guarded Mode Controller",
      "description": "Add native/guarded/auto execution modes and a deterministic controller that isolates each Spec Kit phase in its own session, validates required artifacts before promoting state, and migrates auto -> guarded on unsafe behavior.",
      "source_requirements": [
        "GM-001",
        "GM-002",
        "GM-003",
        "GM-004",
        "GM-005",
        "GM-006",
        "GM-007",
