    {
      "id": "guarded-mode-controller",
      "name": "Guarded Mode Controller",
      "description": "Add native/guarded/auto execution modes and a deterministic controller that isolates each Spec Kit phase in its own session, validates required artifacts before promoting state, and migrates auto -> guarded on unsafe behavior.",
      "source_requirements": [
        "GM-001",
        "GM-002",
        "GM-003",
        "GM-004",
        "GM-005",
        "GM-006",
        "GM-007",
        "GM-008",
        "GM-009",
        "GM-010",
        "GM-011",
        "GM-012"
      ],
      "acceptance_criteria": [
        "--mode accepts native|guarded|auto; default is auto when omitted",
        "guarded mode isolates every phase in its own session with no prior-phase history",
        "no phase is promoted to PASSED without required-artifact validation (non-empty, no placeholders)",
        "writes outside the phase allowlist are rejected",
        "code created before the implement phase is detected and rejected",
        "simulated tool calls printed as text are detected and rejected",
        "timeout and max-attempts-per-phase are enforced; exhausted attempts -> BLOCKED",
        "auto mode migrates irreversibly to guarded per the critical/recoverable event policy",
        "resume is idempotent and never repeats a PASSED phase with a valid fingerprint",
        "transcripts and failure causes are preserved for every attempt",
        "OpenCode adapter works end to end without changing --mode native behavior",
        "python3 -m unittest discover -s spec-master/tests -v passes, including new unit + fake-agent integration tests"
      ],
      "dependencies": [],
      "branch": null,
      "status": "COMPLETED",
      "spec_directory": "specs/001-guarded-mode-controller",
